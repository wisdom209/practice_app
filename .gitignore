```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.js.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.swp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.mypy_cache/
.nyc_output/
coverage/

# Distribution / packaging
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/
.mypy_cache/
.pytest_cache/
.hypothesis/

# IDE
.vscode/
.idea/
*.swp
*.swo
```